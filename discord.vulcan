// examples/discord.vulcan — a Discord-style chat server + client in pure Vulcan.
//
// Built on the net_* TCP socket builtins: no threads, no runtime — one
// single-threaded event loop per process, exactly like the rest of the
// language. Run two terminals:
//
//   vulcan run examples/discord.vulcan server            # port 7777
//   vulcan run examples/discord.vulcan server 0          # ephemeral port (printed)
//   vulcan run examples/discord.vulcan client 127.0.0.1 7777 alice
//
// The server hosts channels with join/part notifications, nick changes,
// direct messages, per-channel history and presence; the client is a raw-mode
// terminal line editor that renders incoming messages live while you type.

struct User {
    nick: string,
    chan: i64,     // index into Server.chans
    conn: i64,     // net handle
    buf: string,   // partial line buffer
}

struct Server {
    users: [User],
    hist: [string],   // flat "chan|nick|text" log, capped
    chans: [string],
    srv: i64,
}

// ---------- helpers ----------

fn chan_index(chans: [string], name: string) -> i64 {
    let n = name
    if n.starts_with("#") == false { n = "#" + n }
    for i in 0 .. chans.len() {
        if chans[i] == n { return i }
    }
    return -1
}

fn norm_chan(name: string) -> string {
    if name.starts_with("#") { return name }
    return "#" + name
}

fn find_by_conn(users: [User], conn: i64) -> i64 {
    for i in 0 .. users.len() {
        if users[i].conn == conn { return i }
    }
    return -1
}

fn find_by_nick(users: [User], nick: string) -> i64 {
    for i in 0 .. users.len() {
        if users[i].nick == nick { return i }
    }
    return -1
}

fn send_line(conn: i64, line: string) -> void {
    net_send(conn, line + "\n")
}

fn sys(conn: i64, text: string) -> void {
    send_line(conn, "SYS|" + text)
}

fn err(conn: i64, text: string) -> void {
    send_line(conn, "ERR|" + text)
}

fn push_hist(st: &mut Server, line: string) -> void {
    st.hist.push(line)
    if st.hist.len() > 120 { st.hist.shift() }
}

fn broadcast(st: &mut Server, chan: i64, nick: string, text: string) -> void {
    let line = "MSG|" + st.chans[chan] + "|" + nick + "|" + text
    push_hist(st, st.chans[chan] + "|" + nick + "|" + text)
    for i in 0 .. st.users.len() {
        if st.users[i].chan == chan { send_line(st.users[i].conn, line) }
    }
    print("server: [" + st.chans[chan] + "] " + nick + ": " + text)
}

fn sys_to_chan(st: &mut Server, chan: i64, text: string) -> void {
    for i in 0 .. st.users.len() {
        if st.users[i].chan == chan { sys(st.users[i].conn, text) }
    }
}

// ---------- command handling ----------

fn handle_line(st: &mut Server, i: i64, line: string) -> void {
    let conn = st.users[i].conn
    let nick = st.users[i].nick
    let chan = st.users[i].chan
    if line == "" { return }
    if line.starts_with("/nick ") {
        let n = line.substring(6, line.len()).trim()
        if n == "" { err(conn, "usage: /nick <name>"); return }
        let old = st.users[i].nick
        st.users[i].nick = n
        sys(conn, "you are now known as " + n)
        sys_to_chan(st, chan, old + " is now known as " + n)
        print("server: " + old + " -> " + n)
        return
    }
    if line.starts_with("/join ") {
        let name = line.substring(6, line.len()).trim()
        let c = chan_index(st.chans, name)
        if c < 0 { err(conn, "no such channel: " + norm_chan(name)); return }
        if c == chan { err(conn, "already in " + st.chans[chan]); return }
        sys_to_chan(st, chan, nick + " left " + st.chans[chan])
        st.users[i].chan = c
        sys(conn, "joined " + st.chans[c] + " (say hi)")
        sys_to_chan(st, c, nick + " joined " + st.chans[c])
        print("server: " + nick + " -> " + st.chans[c])
        return
    }
    if line.starts_with("/msg ") {
        let rest = line.substring(5, line.len())
        let sp = rest.find(" ")
        if sp < 0 { err(conn, "usage: /msg <nick> <text>"); return }
        let target = rest.substring(0, sp).trim()
        let text = rest.substring(sp + 1, rest.len()).trim()
        let t = find_by_nick(st.users, target)
        if t < 0 { err(conn, "no such user: " + target); return }
        send_line(st.users[t].conn, "DM|" + nick + "|" + text)
        sys(conn, "dm to " + target + ": " + text)
        print("server: dm " + nick + " -> " + target)
        return
    }
    if line == "/who" {
        let names: [string] = []
        for j in 0 .. st.users.len() {
            if st.users[j].chan == chan { names.push(st.users[j].nick) }
        }
        sys(conn, "in " + st.chans[chan] + ": " + names.join(", "))
        return
    }
    if line == "/channels" {
        sys(conn, "channels: " + st.chans.join(" "))
        return
    }
    if line == "/history" {
        let shown = 0
        for j in 0 .. st.hist.len() {
            let h = st.hist[j]
            if h.starts_with(st.chans[chan] + "|") {
                let rest = h.substring(st.chans[chan].len() + 1, h.len())
                let p = rest.find("|")
                if p >= 0 {
                    send_line(conn, "MSG|" + st.chans[chan] + "|" + rest.substring(0, p) + "|" + rest.substring(p + 1, rest.len()))
                    shown += 1
                }
            }
        }
        sys(conn, "-- end of history (" + f"{shown}" + " messages) --")
        return
    }
    if line == "/help" {
        sys(conn, "commands: /nick <name>  /join <#chan>  /msg <nick> <text>")
        sys(conn, "          /who  /channels  /history  /help  /quit")
        return
    }
    if line == "/quit" {
        sys(conn, "bye")
        net_close(conn)
        let ch = st.users[i].chan
        st.users.remove(i)
        sys_to_chan(st, ch, nick + " left " + st.chans[ch])
        print("server: " + nick + " disconnected")
        return
    }
    if line.starts_with("/") {
        err(conn, "unknown command: " + line + " (try /help)")
        return
    }
    // plain chat message -> broadcast to the sender's channel
    broadcast(st, chan, nick, line)
}

// ---------- server ----------

fn run_server() -> void {
    let port = 7777
    if arg_count() >= 2 { port = to_int(arg(1)) }
    let srv = net_listen(port)
    if srv < 0 { print("server: cannot listen on port ", port); exit(1) }
    let real_port = net_port(srv)
    let us: [User] = []
    let hist: [string] = []
    let st = Server {
        users: us,
        hist: hist,
        chans: ["#general", "#random", "#dev"],
        srv: srv,
    }
    print("server: listening on port " + f"{real_port}")
    print("server: channels: " + st.chans.join(" "))

    while true {
        // new connections
        if net_ready(st.srv) {
            let c = net_accept(st.srv)
            if c >= 0 {
                st.users.push(User { nick: "guest" + f"{c}", chan: 0, conn: c, buf: "" })
                sys(c, "welcome to Vulcan Discord!")
                sys(c, "you are in #general — set a name with /nick <name>")
                sys(c, "commands: /help")
                print("server: connection from " + net_peer(c))
            }
        }
        // existing users, back to front so removals don't shift pending work
        let i = st.users.len() - 1
        while i >= 0 {
            let conn = st.users[i].conn
            if net_ready(conn) {
                st.users[i].buf = st.users[i].buf + net_recv(conn)
                while true {
                    let nl = st.users[i].buf.find("\n")
                    if nl < 0 { break }
                    let line = st.users[i].buf.substring(0, nl).trim()
                    st.users[i].buf = st.users[i].buf.substring(nl + 1, st.users[i].buf.len())
                    if find_by_conn(st.users, conn) < 0 { break }  // /quit removed us
                    handle_line(st, find_by_conn(st.users, conn), line)
                }
            }
            if find_by_conn(st.users, conn) < 0 {
                i -= 1
                continue
            }
            if net_alive(conn) == false {
                let nick = st.users[i].nick
                let ch = st.users[i].chan
                net_close(conn)
                st.users.remove(i)
                sys_to_chan(st, ch, nick + " left " + st.chans[ch])
                print("server: " + nick + " dropped")
            }
            i -= 1
        }
        sleep_ms(20)
    }
}

// ---------- client ----------

// ---- the app's own interface: the shell draws nothing; this client renders
// a real chat UI — header, live message list, input bar — via ui_html/ui_css,
// and polls keys itself. The terminal stays as the hidden backend: the same
// output still appears when the program runs natively with no shell. ----

struct ChatUi {
    msgs: [string],   // rendered HTML rows, capped
    input: string,    // the line being typed (shown in the input bar)
    chan: string,      // current channel, shown in the header
    state: string,    // header status line
}

// escape text for HTML — char by char (replace() is first-match-only in JS)
fn esc(s: string) -> string {
    if s == "" { return "" }
    let out = ""
    for i in 0 ..= s.len() - 1 {
        let c = char_at(s, i)
        // entities spelled with chr() so no raw markup lives in the source
        if c == 38 { out = out + chr(38) + "amp;" }
        elif c == 60 { out = out + chr(38) + "lt;" }
        elif c == 62 { out = out + chr(38) + "gt;" }
        elif c == 34 { out = out + chr(38) + "quot;" }
        else { out = out + chr(c) }
    }
    return out
}

// a stable color per nickname, like a real chat client
fn hex_color(nick: string) -> string {
    let palette = ["#5865f2", "#57f287", "#fee75c", "#eb459e", "#ed4245",
                   "#f47b67", "#00a8fc", "#f5c96b", "#9b59b6", "#1abc9c"]
    if nick.len() == 0 { return "#dbdee1" }
    let h = 0
    for i in 0 ..= nick.len() - 1 { h = (h * 31 + char_at(nick, i)) % 997 }
    return palette[h % 10]
}

// the same idea for the hidden terminal backend (ANSI palette)
fn nick_color(nick: string) -> i64 {
    if nick.len() == 0 { return 12 }
    let palette = [2, 3, 4, 5, 6, 10, 11, 12, 13, 14]
    let h = 0
    for i in 0 ..= nick.len() - 1 { h = (h * 31 + char_at(nick, i)) % 997 }
    return palette[h % 10]
}

fn ui_setup() -> void {
    ui_title("Vulcan Discord")
    // Discord-dark chat app: the terminal/canvas are the hidden backend
    ui_css(
        "#term,#vscreen{display:none!important}" +
        "html,body{margin:0;height:100%;background:#313338;overflow:hidden}" +
        "#vulcan-ui{font-family:'Segoe UI',system-ui,-apple-system,sans-serif}" +
        ".app{position:absolute;inset:0;display:flex;flex-direction:column;background:#313338;color:#dbdee1}" +
        ".hdr{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:#2b2d31;font-weight:700;border-bottom:1px solid #1e1f22}" +
        ".hchan{font-size:16px}" +
        ".hstat{font-size:12px;font-weight:400;color:#9aa0a6}" +
        ".msgs{flex:1;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding:16px}" +
        ".m{margin:3px 0;font-size:15px;line-height:1.35;overflow-wrap:break-word;word-wrap:break-word}" +
        ".m .n{font-weight:700;margin-right:8px}" +
        ".sysm{color:#9aa0a6;font-size:13px}" +
        ".errm{color:#f23f42;font-size:13px}" +
        ".dmtag{display:inline-block;background:#eb459e;color:#313338;font-size:11px;font-weight:700;border-radius:4px;padding:1px 5px;margin-right:8px}" +
        ".ibar{margin:0 16px 24px;background:#383a40;border-radius:8px;padding:12px 16px;font-size:15px;color:#dbdee1;overflow-wrap:break-word;word-wrap:break-word}" +
        ".ph{color:#87898c}" +
        ".cur{display:inline-block;width:2px;height:17px;background:#dbdee1;vertical-align:-3px;margin-left:1px;animation:vbl 1.1s steps(1) infinite}" +
        "@keyframes vbl{50%{opacity:0}}" +
        ".cwrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#313338}" +
        ".card{width:86%;max-width:420px;text-align:center}" +
        ".clogo{font-size:28px;font-weight:800;letter-spacing:2px;color:#5865f2;margin-bottom:6px}" +
        ".csub{color:#9aa0a6;font-size:14px;margin-bottom:28px}" +
        ".cstat{margin-top:14px;font-size:14px;color:#9aa0a6}" +
        ".cerr{margin-top:14px;font-size:14px;color:#f23f42}"
    )
}

// the chat view: header, message list (newest at the bottom), input bar
fn ui_render_chat(ui: &ChatUi) -> void {
    let body = ""
    for i in 0 .. ui.msgs.len() { body = body + ui.msgs[i] }
    let inp = ""
    if ui.input == "" {
        inp = "<span class='ph'>Message " + esc(ui.chan) + "</span>"
    } else {
        inp = esc(ui.input) + "<span class='cur'></span>"
    }
    ui_html("<div class='app'>" +
        "<div class='hdr'><span class='hchan'>" + esc(ui.chan) + "</span>" +
        "<span class='hstat'>" + esc(ui.state) + "</span></div>" +
        "<div class='msgs'>" + body + "</div>" +
        "<div class='ibar'>" + inp + "</div>" +
        "</div>")
}

// the connect view: centered card with the same input bar
fn ui_render_connect(ui: &ChatUi, status: string, is_err: i64) -> void {
    let inp = ""
    if ui.input == "" {
        inp = "<span class='ph'>server address — host or host:port</span>"
    } else {
        inp = esc(ui.input) + "<span class='cur'></span>"
    }
    let stat = ""
    if is_err != 0 {
        stat = "<div class='cerr'>" + esc(status) + "</div>"
    } else {
        stat = "<div class='cstat'>" + esc(status) + "</div>"
    }
    ui_html("<div class='cwrap'><div class='card'>" +
        "<div class='clogo'>VULCAN DISCORD</div>" +
        "<div class='csub'>chat over TCP — run the server anywhere, connect from here</div>" +
        "<div class='ibar'>" + inp + "</div>" +
        stat +
        "</div></div>")
}

// feed one key into the input line; 1 = Enter, 2 = ctrl-c/ctrl-d, 0 = edited
fn ui_key(ui: &mut ChatUi, k: i64) -> i64 {
    if k == 13 || k == 10 { return 1 }
    if k == 3 || k == 4 { return 2 }
    if k == 127 || k == 8 {
        if ui.input.len() > 0 {
            ui.input = ui.input.substring(0, ui.input.len() - 1)
        }
        return 0
    }
    if k >= 32 && k < 127 { ui.input = ui.input + chr(k) }
    return 0
}

// one rendered row per kind of server line
fn ui_row_msg(ui: &mut ChatUi, nick: string, text: string) -> void {
    ui.msgs.push("<div class='m'><span class='n' style='color:" + hex_color(nick) +
        "'>" + esc(nick) + "</span><span class='t'>" + esc(text) + "</span></div>")
    if ui.msgs.len() > 200 { ui.msgs.shift() }
}

fn ui_row_dm(ui: &mut ChatUi, nick: string, text: string) -> void {
    ui.msgs.push("<div class='m'><span class='dmtag'>DM</span><span class='n' style='color:" +
        hex_color(nick) + "'>" + esc(nick) + "</span><span class='t'>" + esc(text) + "</span></div>")
    if ui.msgs.len() > 200 { ui.msgs.shift() }
}

fn ui_row_sys(ui: &mut ChatUi, text: string) -> void {
    ui.msgs.push("<div class='m sysm'>* " + esc(text) + "</div>")
    if ui.msgs.len() > 200 { ui.msgs.shift() }
}

fn ui_row_err(ui: &mut ChatUi, text: string) -> void {
    ui.msgs.push("<div class='m errm'>! " + esc(text) + "</div>")
    if ui.msgs.len() > 200 { ui.msgs.shift() }
}

fn prompt_marker() -> void {
    set_color(63, -1)
    put("> ")
    set_color(-1, -1)
}

fn handle_server_line(ui: &mut ChatUi, line: string) -> void {
    if line.starts_with("MSG|") {
        let rest = line.substring(4, line.len())
        let p1 = rest.find("|")
        if p1 < 0 { return }
        // parse chan|nick|text manually: first | then next |
        let chan = rest.substring(0, p1)
        let after = rest.substring(p1 + 1, rest.len())
        let p3 = after.find("|")
        if p3 < 0 { return }
        let nick = after.substring(0, p3)
        let text = after.substring(p3 + 1, after.len())
        if ui.chan != chan { ui.chan = chan }
        set_color(8, -1)
        put("[" + chan + "] ")
        set_color(nick_color(nick), -1)
        put(nick)
        set_color(-1, -1)
        put(": " + text + "\n")
        ui_row_msg(ui, nick, text)
        ui_render_chat(ui)
        return
    }
    if line.starts_with("DM|") {
        let rest = line.substring(3, line.len())
        let p = rest.find("|")
        if p < 0 { return }
        let who = rest.substring(0, p)
        let text = rest.substring(p + 1, rest.len())
        set_color(13, -1)
        put("[dm] ")
        set_color(nick_color(who), -1)
        put(who)
        set_color(-1, -1)
        put(": " + text + "\n")
        ui_row_dm(ui, who, text)
        ui_render_chat(ui)
        return
    }
    if line.starts_with("SYS|") {
        set_color(8, -1)
        put("* " + line.substring(4, line.len()) + "\n")
        set_color(-1, -1)
        ui_row_sys(ui, line.substring(4, line.len()))
        ui_render_chat(ui)
        return
    }
    if line.starts_with("ERR|") {
        set_color(9, -1)
        put("! " + line.substring(4, line.len()) + "\n")
        set_color(-1, -1)
        ui_row_err(ui, line.substring(4, line.len()))
        ui_render_chat(ui)
        return
    }
}

// the app's own connect screen: a centered card, an address bar typed with
// the same key editor as chat, and a retry loop so a phone user never hits
// a dead end
fn connect_screen(ui: &mut ChatUi) -> i64 {
    let port = 7777
    let hint = "type the server address, then press Enter"
    ui.input = ""
    ui_render_connect(ui, hint, 0)
    while true {
        if key_ready() != 0 {
            let r = ui_key(ui, read_key())
            if r == 2 { exit(0) }
            if r == 1 {
                let a = ui.input
                if a == "" { a = "127.0.0.1" }
                let h = a
                let p = port
                if a.find(":") >= 0 {
                    h = a.substring(0, a.find(":"))
                    p = to_int(a.substring(a.find(":") + 1, a.len()))
                }
                ui.input = ""
                ui_render_connect(ui, "connecting to " + h + ":" + f"{p}" + " …", 0)
                let conn = net_connect(h, p)
                if conn >= 0 {
                    ui.state = "connected"
                    return conn
                }
                ui_render_connect(ui, "cannot reach " + h + ":" + f"{p}" +
                    " — is the server running there?", 1)
                sleep_ms(1500)
                ui.input = ""
                ui_render_connect(ui, hint, 0)
                continue
            }
            ui_render_connect(ui, hint, 0)
        }
        sleep_ms(25)
    }
}

fn run_client() -> void {
    ui_setup()
    let msgs: [string] = []
    let ui = ChatUi { msgs: msgs, input: "", chan: "#general", state: "" }
    let host = ""
    let port = 7777
    if arg_count() >= 2 { host = arg(1) }
    if arg_count() >= 3 { port = to_int(arg(2)) }
    let conn = -1
    if host != "" {
        conn = net_connect(host, port)
        if conn < 0 { print("client: cannot connect to " + host + ":" + f"{port}"); exit(1) }
        ui.state = "connected"
        ui_render_chat(&ui)
    } else {
        conn = connect_screen(&ui)
        ui_render_chat(&ui)
    }
    if arg_count() >= 4 {
        send_line(conn, "/nick " + arg(3))
    }
    term_raw()
    defer { term_normal() }
    let inbox = ""
    prompt_marker()
    while true {
        if net_ready(conn) {
            inbox = inbox + net_recv(conn)
            while true {
                let nl = inbox.find("\n")
                if nl < 0 { break }
                let line = inbox.substring(0, nl)
                inbox = inbox.substring(nl + 1, inbox.len())
                handle_server_line(&ui, line)
            }
            prompt_marker()
        }
        if key_ready() != 0 {
            let k = read_key()
            if k == 3 || k == 4 {
                send_line(conn, "/quit")
                print("")
                net_close(conn)
                exit(0)
            } elif k == 10 || k == 13 {
                print("")
                if ui.input != "" { send_line(conn, ui.input) }
                ui.input = ""
                prompt_marker()
                ui_render_chat(&ui)
            } elif k == 127 || k == 8 {
                if ui.input.len() > 0 {
                    ui.input = ui.input.substring(0, ui.input.len() - 1)
                    put("\b \b")
                    ui_render_chat(&ui)
                }
            } elif k >= 32 && k < 127 {
                ui.input = ui.input + chr(k)
                put(chr(k))
                ui_render_chat(&ui)
            }
        }
        if net_alive(conn) == false {
            print("")
            print("* disconnected from server")
            ui.state = "disconnected"
            ui_row_sys(&ui, "disconnected from server")
            ui_render_chat(&ui)
            exit(0)
        }
        sleep_ms(25)
    }
}

fn main() -> void {
    // no args = client mode (the APK/browser build has no argv): the host
    // prompt below makes that usable from a phone
    let mode = arg(0)
    if mode == "server" { run_server(); return }
    if mode == "client" || mode == "" { run_client(); return }
    print("usage: discord server [port]   — start the chat server")
    print("       discord client [host] [port] [nick] — join it")
    print("unknown mode: " + mode)
    exit(1)
}
