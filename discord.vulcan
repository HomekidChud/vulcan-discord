// examples/discord.vulcan — a Discord-style chat server + client in pure Vulcan.
//
// Built on the net_* TCP socket builtins: no threads, no runtime — one
// single-threaded event loop per process, exactly like the rest of the
// language. Run two terminals:
//
//   vulcan run examples/discord.vulcan server            # port 7777
//   vulcan run examples/discord.vulcan server 0          # ephemeral port (printed)
//   vulcan run examples/discord.vulcan client 127.0.0.1 7777 alice
//
// The server hosts channels with join/part notifications, nick changes,
// direct messages, per-channel history and presence; the client is a raw-mode
// terminal line editor that renders incoming messages live while you type.

struct User {
    nick: string,
    chan: i64,     // index into Server.chans
    conn: i64,     // net handle
    buf: string,   // partial line buffer
}

struct Server {
    users: [User],
    hist: [string],   // flat "chan|nick|text" log, capped
    chans: [string],
    srv: i64,
}

// ---------- helpers ----------

fn chan_index(chans: [string], name: string) -> i64 {
    let n = name
    if n.starts_with("#") == false { n = "#" + n }
    for i in 0 .. chans.len() {
        if chans[i] == n { return i }
    }
    return -1
}

fn norm_chan(name: string) -> string {
    if name.starts_with("#") { return name }
    return "#" + name
}

fn find_by_conn(users: [User], conn: i64) -> i64 {
    for i in 0 .. users.len() {
        if users[i].conn == conn { return i }
    }
    return -1
}

fn find_by_nick(users: [User], nick: string) -> i64 {
    for i in 0 .. users.len() {
        if users[i].nick == nick { return i }
    }
    return -1
}

fn send_line(conn: i64, line: string) -> void {
    net_send(conn, line + "\n")
}

fn sys(conn: i64, text: string) -> void {
    send_line(conn, "SYS|" + text)
}

fn err(conn: i64, text: string) -> void {
    send_line(conn, "ERR|" + text)
}

fn push_hist(st: &mut Server, line: string) -> void {
    st.hist.push(line)
    if st.hist.len() > 120 { st.hist.shift() }
}

fn broadcast(st: &mut Server, chan: i64, nick: string, text: string) -> void {
    let line = "MSG|" + st.chans[chan] + "|" + nick + "|" + text
    push_hist(st, st.chans[chan] + "|" + nick + "|" + text)
    for i in 0 .. st.users.len() {
        if st.users[i].chan == chan { send_line(st.users[i].conn, line) }
    }
    print("server: [" + st.chans[chan] + "] " + nick + ": " + text)
}

fn sys_to_chan(st: &mut Server, chan: i64, text: string) -> void {
    for i in 0 .. st.users.len() {
        if st.users[i].chan == chan { sys(st.users[i].conn, text) }
    }
}

// ---------- command handling ----------

fn handle_line(st: &mut Server, i: i64, line: string) -> void {
    let conn = st.users[i].conn
    let nick = st.users[i].nick
    let chan = st.users[i].chan
    if line == "" { return }
    if line.starts_with("/nick ") {
        let n = line.substring(6, line.len()).trim()
        if n == "" { err(conn, "usage: /nick <name>"); return }
        let old = st.users[i].nick
        st.users[i].nick = n
        sys(conn, "you are now known as " + n)
        sys_to_chan(st, chan, old + " is now known as " + n)
        print("server: " + old + " -> " + n)
        return
    }
    if line.starts_with("/join ") {
        let name = line.substring(6, line.len()).trim()
        let c = chan_index(st.chans, name)
        if c < 0 { err(conn, "no such channel: " + norm_chan(name)); return }
        if c == chan { err(conn, "already in " + st.chans[chan]); return }
        sys_to_chan(st, chan, nick + " left " + st.chans[chan])
        st.users[i].chan = c
        sys(conn, "joined " + st.chans[c] + " (say hi)")
        sys_to_chan(st, c, nick + " joined " + st.chans[c])
        print("server: " + nick + " -> " + st.chans[c])
        return
    }
    if line.starts_with("/msg ") {
        let rest = line.substring(5, line.len())
        let sp = rest.find(" ")
        if sp < 0 { err(conn, "usage: /msg <nick> <text>"); return }
        let target = rest.substring(0, sp).trim()
        let text = rest.substring(sp + 1, rest.len()).trim()
        let t = find_by_nick(st.users, target)
        if t < 0 { err(conn, "no such user: " + target); return }
        send_line(st.users[t].conn, "DM|" + nick + "|" + text)
        sys(conn, "dm to " + target + ": " + text)
        print("server: dm " + nick + " -> " + target)
        return
    }
    if line == "/who" {
        let names: [string] = []
        for j in 0 .. st.users.len() {
            if st.users[j].chan == chan { names.push(st.users[j].nick) }
        }
        sys(conn, "in " + st.chans[chan] + ": " + names.join(", "))
        return
    }
    if line == "/channels" {
        sys(conn, "channels: " + st.chans.join(" "))
        return
    }
    if line == "/history" {
        let shown = 0
        for j in 0 .. st.hist.len() {
            let h = st.hist[j]
            if h.starts_with(st.chans[chan] + "|") {
                let rest = h.substring(st.chans[chan].len() + 1, h.len())
                let p = rest.find("|")
                if p >= 0 {
                    send_line(conn, "MSG|" + st.chans[chan] + "|" + rest.substring(0, p) + "|" + rest.substring(p + 1, rest.len()))
                    shown += 1
                }
            }
        }
        sys(conn, "-- end of history (" + f"{shown}" + " messages) --")
        return
    }
    if line == "/help" {
        sys(conn, "commands: /nick <name>  /join <#chan>  /msg <nick> <text>")
        sys(conn, "          /who  /channels  /history  /help  /quit")
        return
    }
    if line == "/quit" {
        sys(conn, "bye")
        net_close(conn)
        let ch = st.users[i].chan
        st.users.remove(i)
        sys_to_chan(st, ch, nick + " left " + st.chans[ch])
        print("server: " + nick + " disconnected")
        return
    }
    if line.starts_with("/") {
        err(conn, "unknown command: " + line + " (try /help)")
        return
    }
    // plain chat message -> broadcast to the sender's channel
    broadcast(st, chan, nick, line)
}

// ---------- server ----------

fn run_server() -> void {
    let port = 7777
    if arg_count() >= 2 { port = to_int(arg(1)) }
    let srv = net_listen(port)
    if srv < 0 { print("server: cannot listen on port ", port); exit(1) }
    let real_port = net_port(srv)
    let us: [User] = []
    let hist: [string] = []
    let st = Server {
        users: us,
        hist: hist,
        chans: ["#general", "#random", "#dev"],
        srv: srv,
    }
    print("server: listening on port " + f"{real_port}")
    print("server: channels: " + st.chans.join(" "))

    while true {
        // new connections
        if net_ready(st.srv) {
            let c = net_accept(st.srv)
            if c >= 0 {
                st.users.push(User { nick: "guest" + f"{c}", chan: 0, conn: c, buf: "" })
                sys(c, "welcome to Vulcan Discord!")
                sys(c, "you are in #general — set a name with /nick <name>")
                sys(c, "commands: /help")
                print("server: connection from " + net_peer(c))
            }
        }
        // existing users, back to front so removals don't shift pending work
        let i = st.users.len() - 1
        while i >= 0 {
            let conn = st.users[i].conn
            if net_ready(conn) {
                st.users[i].buf = st.users[i].buf + net_recv(conn)
                while true {
                    let nl = st.users[i].buf.find("\n")
                    if nl < 0 { break }
                    let line = st.users[i].buf.substring(0, nl).trim()
                    st.users[i].buf = st.users[i].buf.substring(nl + 1, st.users[i].buf.len())
                    if find_by_conn(st.users, conn) < 0 { break }  // /quit removed us
                    handle_line(st, find_by_conn(st.users, conn), line)
                }
            }
            if find_by_conn(st.users, conn) < 0 {
                i -= 1
                continue
            }
            if net_alive(conn) == false {
                let nick = st.users[i].nick
                let ch = st.users[i].chan
                net_close(conn)
                st.users.remove(i)
                sys_to_chan(st, ch, nick + " left " + st.chans[ch])
                print("server: " + nick + " dropped")
            }
            i -= 1
        }
        sleep_ms(20)
    }
}

// ---------- client ----------

// ---- the app's own look: the shell draws nothing, the app styles itself ----
// ui_* calls are no-ops where there is no shell (native terminal); the ANSI
// colors work on every backend.
fn ui_setup() -> void {
    ui_title("Discord — Vulcan")
    // Discord dark theme for the web/APK shell
    ui_css("body{background:#313338;color:#dbdee1}#screen{font-size:15px}")
}

fn nick_color(nick: string) -> i64 {
    // a stable color per nickname, like a real chat client
    if nick.len() == 0 { return 12 }
    let palette = [2, 3, 4, 5, 6, 10, 11, 12, 13, 14]
    let h = 0
    for i in 0 ..= nick.len() - 1 {
        h = (h * 31 + char_at(nick, i)) % 997
    }
    return palette[h % 10]
}

fn prompt_marker() -> void {
    set_color(63, -1)
    put("> ")
    set_color(-1, -1)
}

fn handle_server_line(line: string) -> void {
    if line.starts_with("MSG|") {
        let rest = line.substring(4, line.len())
        let p1 = rest.find("|")
        if p1 < 0 { return }
        // parse chan|nick|text manually: first | then next |
        let chan = rest.substring(0, p1)
        let after = rest.substring(p1 + 1, rest.len())
        let p3 = after.find("|")
        if p3 < 0 { return }
        let nick = after.substring(0, p3)
        set_color(8, -1)
        put("[" + chan + "] ")
        set_color(nick_color(nick), -1)
        put(nick)
        set_color(-1, -1)
        put(": " + after.substring(p3 + 1, after.len()) + "\n")
        return
    }
    if line.starts_with("DM|") {
        let rest = line.substring(3, line.len())
        let p = rest.find("|")
        if p < 0 { return }
        let who = rest.substring(0, p)
        set_color(13, -1)
        put("[dm] ")
        set_color(nick_color(who), -1)
        put(who)
        set_color(-1, -1)
        put(": " + rest.substring(p + 1, rest.len()) + "\n")
        return
    }
    if line.starts_with("SYS|") {
        set_color(8, -1)
        put("* " + line.substring(4, line.len()) + "\n")
        set_color(-1, -1)
        return
    }
    if line.starts_with("ERR|") {
        set_color(9, -1)
        put("! " + line.substring(4, line.len()) + "\n")
        set_color(-1, -1)
        return
    }
}

// the app's own connect screen: colored banner, address entry with optional
// :port, and a retry loop so a phone user never hits a dead end
fn connect_screen() -> i64 {
    let port = 7777
    while true {
        clear_screen()
        set_color(63, -1)
        put("┌─────────────────────────────┐\n")
        put("│      VULCAN  DISCORD        │\n")
        put("└─────────────────────────────┘\n")
        set_color(-1, -1)
        set_color(8, -1)
        put("chat over TCP — run `discord server` anywhere and connect\n\n")
        set_color(-1, -1)
        set_color(63, -1)
        put("server address")
        set_color(-1, -1)
        put(" [127.0.0.1]: ")
        let a = input()
        if a == "" { a = "127.0.0.1" }
        let h = a
        if a.find(":") >= 0 {
            h = a.substring(0, a.find(":"))
            port = to_int(a.substring(a.find(":") + 1, a.len()))
        }
        set_color(8, -1)
        put("\nconnecting to " + h + ":" + f"{port}" + " …\n")
        set_color(-1, -1)
        let conn = net_connect(h, port)
        if conn >= 0 {
            set_color(10, -1)
            put("connected — ctrl-c quits\n\n")
            set_color(-1, -1)
            return conn
        }
        set_color(9, -1)
        put("✗ cannot reach " + h + ":" + f"{port}" + " — is the server running there?\n\n")
        set_color(-1, -1)
    }
}

fn run_client() -> void {
    ui_setup()
    let host = ""
    let port = 7777
    if arg_count() >= 2 { host = arg(1) }
    if arg_count() >= 3 { port = to_int(arg(2)) }
    let conn = -1
    if host != "" {
        conn = net_connect(host, port)
        if conn < 0 { print("client: cannot connect to " + host + ":" + f"{port}"); exit(1) }
    } else {
        conn = connect_screen()
    }
    if arg_count() >= 4 {
        send_line(conn, "/nick " + arg(3))
    }
    term_raw()
    defer { term_normal() }
    let buf = ""
    let inbox = ""
    prompt_marker()
    while true {
        if net_ready(conn) {
            inbox = inbox + net_recv(conn)
            while true {
                let nl = inbox.find("\n")
                if nl < 0 { break }
                let line = inbox.substring(0, nl)
                inbox = inbox.substring(nl + 1, inbox.len())
                handle_server_line(line)
            }
            prompt_marker()
        }
        if key_ready() != 0 {
            let k = read_key()
            if k == 10 || k == 13 {
                print("")
                if buf != "" { send_line(conn, buf) }
                buf = ""
                prompt_marker()
            } elif k == 127 || k == 8 {
                if buf.len() > 0 {
                    buf = buf.substring(0, buf.len() - 1)
                    put("\b \b")
                }
            } elif k == 3 || k == 4 {
                send_line(conn, "/quit")
                print("")
                net_close(conn)
                exit(0)
            } elif k >= 32 && k < 127 {
                buf = buf + chr(k)
                put(chr(k))
            }
        }
        if net_alive(conn) == false {
            print("")
            print("* disconnected from server")
            exit(0)
        }
        sleep_ms(25)
    }
}

fn main() -> void {
    // no args = client mode (the APK/browser build has no argv): the host
    // prompt below makes that usable from a phone
    let mode = arg(0)
    if mode == "server" { run_server(); return }
    if mode == "client" || mode == "" { run_client(); return }
    print("usage: discord server [port]   — start the chat server")
    print("       discord client [host] [port] [nick] — join it")
    print("unknown mode: " + mode)
    exit(1)
}
